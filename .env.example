PORT=3000
# Where bot wallets (encrypted) and trade history are stored. On Render, point this at a persistent disk.
DATA_DIR=./data
# devnet for testing, mainnet-beta for live trading (Jupiter only routes on mainnet).
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Mainnet RPC used for token safety checks when SOLANA_NETWORK is not mainnet-beta.
MARKET_RPC_URL=https://api.mainnet-beta.solana.com
# Generate with: openssl rand -hex 32. Back it up: losing it locks every bot wallet.
WALLET_ENCRYPTION_KEY=
# Generate a long random token. Do not commit or share it.
ADMIN_API_TOKEN=
# Optional treasury key for the treasury withdrawal panel.
TREASURY_SECRET_KEY=
# Live trading spends real SOL. Requires SOLANA_NETWORK=mainnet-beta.
ENABLE_LIVE_TRADING=false
# Free key from https://portal.jup.ag: much higher Jupiter limits, and faster loops (1s positions, 3s scans).
JUPITER_API_KEY=
# Position check and market scan intervals (ms). Defaults: 3000/6000 without a Jupiter key, 1000/3000 with one.
ENGINE_MONITOR_MS=
ENGINE_SCAN_MS=
# Log a system check to stdout on startup.
SELFTEST_ON_BOOT=false
ENABLE_DEV_FEE_TRANSFERS=false
ENABLE_LIVE_SWEEP=false
DEV_WALLET_ADDRESS=8ooeEAN637seumjXGMed7KXGv9fQBDoniDgtEBsYpbku
DEV_FEE_PERCENT=10

PORT=3000
# Start on devnet. Change to mainnet-beta only after test and independent review.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=
# Generate a long random token. Do not commit or share it.
ADMIN_API_TOKEN=
# Treasury key is only used for the existing treasury withdrawal screen.
TREASURY_SECRET_KEY=
# Explicitly set true only after devnet tests and wallet verification.
ENABLE_DEV_FEE_TRANSFERS=false
ENABLE_LIVE_SWEEP=false
DEV_WALLET_ADDRESS=8ooeEAN637seumjXGMed7KXGv9fQBDoniDgtEBsYpbku
DEV_FEE_PERCENT=10
DATA_DIR=./data
